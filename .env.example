# Database PostgreSQL (es. Neon)
# Connection string usata sia dal server a runtime sia da Prisma CLI per le migration.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Override opzionale per Prisma CLI (migrate/resolve/db execute), se deve puntare
# a una URL diversa da DATABASE_URL.
PRISMA_CLI_URL=""

# Schema PostgreSQL dedicato che ospita tutte le tabelle applicative (default: televoto).
# Il server usa questo valore per l'adapter Prisma; la CLI Prisma lo riceve come
# parametro `?schema=` aggiunto automaticamente da prisma.config.ts.
DATABASE_SCHEMA="televoto"

# API Configuration (per sviluppo)
VITE_API_URL=http://localhost:3001

# Sicurezza admin (obbligatorio in produzione)
ADMIN_AUTH_SECRET="change-me-with-a-long-random-secret"

# Bootstrap credenziale root (usata se la tabella RootCredential è vuota)
ROOT_ADMIN_PASSWORD="ChangeMeRoot2026!"
