generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VoterType {
  QUALIFICATA
  POPOLARE

  @@map("voter_type")
}

enum VoterStatus {
  ACTIVE
  SUBMITTED

  @@map("voter_status")
}

enum PopularVoteMode {
  NUMERIC
  SINGLE

  @@map("popular_vote_mode")
}

model Event {
  id                    String                  @id @default(cuid())
  code                  String                  @unique
  name                  String
  subtitle              String?
  active                Boolean                 @default(true)
  votingClosed          Boolean                 @default(false) @map("voting_closed")
  weightQualificata     Int                     @default(70) @map("weight_qualificata")
  weightPopolare        Int                     @default(30) @map("weight_popolare")
  enableTrimmedMean     Boolean                 @default(false) @map("enable_trimmed_mean")
  trimmedMeanPercentage Float                   @default(10.0) @map("trimmed_mean_percentage")
  popularVoteMode       PopularVoteMode         @default(NUMERIC) @map("popular_vote_mode")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  candidates            Candidate[]
  judgeTokens           JudgeToken[]
  managerCredential     EventManagerCredential?

  @@map("event")
}

model RootCredential {
  id                 String   @id
  passwordHash       String   @map("password_hash")
  passwordSalt       String   @map("password_salt")
  passwordIterations Int      @map("password_iterations")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("root_credential")
}

model EventManagerCredential {
  id                 String   @id @default(cuid())
  eventId            String   @unique @map("event_id")
  passwordHash       String   @map("password_hash")
  passwordSalt       String   @map("password_salt")
  passwordIterations Int      @map("password_iterations")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_manager_credential")
}

model Candidate {
  id         String             @id @default(cuid())
  eventId    String             @map("event_id")
  number     Int
  name       String
  subtitle   String?
  color      String             @default("#6366f1")
  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes      Vote[]
  templateId String?            @map("template_id")
  template   CandidateTemplate? @relation(fields: [templateId], references: [id])

  @@unique([eventId, number])
  @@map("candidate")
}

model CandidateTemplate {
  id         String      @id @default(cuid())
  name       String
  subtitle   String?
  color      String      @default("#6366f1")
  candidates Candidate[]

  @@map("candidate_template")
}

model JudgeToken {
  id           String      @id @default(cuid())
  eventId      String      @map("event_id")
  label        String?
  type         VoterType   @default(QUALIFICATA)
  status       VoterStatus @default(ACTIVE)
  tokenHash    String      @unique @map("token_hash")
  tokenPreview String      @map("token_preview")
  createdAt    DateTime    @default(now()) @map("created_at")
  finalizedAt  DateTime?   @map("finalized_at")
  usedAt       DateTime?   @map("used_at")
  revokedAt    DateTime?   @map("revoked_at")
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes        Vote[]

  @@index([eventId])
  @@map("judge_token")
}

model Vote {
  id           String      @id @default(cuid())
  candidateId  String      @map("candidate_id")
  deviceId     String?     @map("device_id")
  judgeTokenId String?     @map("judge_token_id")
  score        Int?
  createdAt    DateTime    @default(now()) @map("created_at")
  candidate    Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  judgeToken   JudgeToken? @relation(fields: [judgeTokenId], references: [id], onDelete: SetNull)

  @@unique([candidateId, deviceId])
  @@unique([candidateId, judgeTokenId])
  @@map("vote")
}
