generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VoterType {
  QUALIFICATA
  POPOLARE
}

enum VoterStatus {
  ACTIVE
  SUBMITTED
}

enum PopularVoteMode {
  NUMERIC
  SINGLE
}

model Event {
  id                String                  @id @default(cuid())
  code              String                  @unique
  name              String
  subtitle          String?
  active            Boolean                 @default(true)
  votingClosed      Boolean                 @default(false)
  weightQualificata Int                     @default(70)
  weightPopolare    Int                     @default(30)
  enableTrimmedMean Boolean                 @default(false)
  trimmedMeanPercentage Float               @default(10.0)
  popularVoteMode   PopularVoteMode         @default(NUMERIC)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  candidates        Candidate[]
  judgeTokens       JudgeToken[]
  managerCredential EventManagerCredential?
}

model RootCredential {
  id                  String   @id
  passwordHash        String
  passwordSalt        String
  passwordIterations  Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EventManagerCredential {
  id                  String   @id @default(cuid())
  eventId             String   @unique
  passwordHash        String
  passwordSalt        String
  passwordIterations  Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Candidate {
  id        String   @id @default(cuid())
  eventId   String
  number    Int
  name      String
  subtitle  String?
  color     String   @default("#6366f1")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes     Vote[]
  templateId String?
  template  CandidateTemplate? @relation(fields: [templateId], references: [id])

  @@unique([eventId, number])
}

model CandidateTemplate {
  id        String   @id @default(cuid())
  name      String
  subtitle  String?
  color     String   @default("#6366f1")
  candidates Candidate[]
}

model JudgeToken {
  id           String   @id @default(cuid())
  eventId      String
  label        String?
  type         VoterType @default(QUALIFICATA)
  status       VoterStatus @default(ACTIVE)
  tokenHash    String   @unique
  tokenPreview String
  createdAt    DateTime @default(now())
  finalizedAt  DateTime?
  usedAt       DateTime?
  revokedAt    DateTime?
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes        Vote[]

  @@index([eventId])
}

model Vote {
  id            String       @id @default(cuid())
  candidateId   String
  deviceId      String?
  judgeTokenId  String?
  score         Int?
  createdAt     DateTime     @default(now())
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  judgeToken    JudgeToken?  @relation(fields: [judgeTokenId], references: [id], onDelete: SetNull)

  @@unique([candidateId, deviceId])
  @@unique([candidateId, judgeTokenId])
}
