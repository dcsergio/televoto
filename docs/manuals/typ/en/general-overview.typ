#section-title[Security and reliability]

#card-grid(
  cols: 3,
  card(icon: "🔑", title: "Separate access levels")[
    Dedicated password for the general administrator and for each individual event organizer.
  ],
  card(icon: "🎟", title: "Protected codes")[
    Voting codes are opaque and single-use, stored only in encrypted form: never in plain text
    in the system.
  ],
  card(icon: "🕵", title: "No tracking")[
    Voters are not profiled: no personal data or device identifier is collected.
  ],
)

