{
  "name": "televoto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start --workspace client\" \"tsx server/index.ts\"",
    "dev:client": "npm run start --workspace client",
    "dev:server": "tsx server/index.ts",
    "prebuild": "npx prisma generate",
    "build": "tsc -b && npm run build --workspace client",
    "lint": "oxlint",
    "test:client": "npm run test --workspace client",
    "test:e2e": "playwright test",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:pooler": "set PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1&& npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.11.3",
    "prisma": "^7.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.11.2",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "better-sqlite3@12.11.1": true
  }
}
